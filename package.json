{
  "name": "crypto-screener-backend",
  "version": "1.0.0",
  "description": "Crypto screener backend with Binance integration, LLM summaries, and trade execution",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:migrate": "typeorm migration:run -d dist/database/database.module.js",
    "db:generate": "typeorm migration:generate -d dist/database/database.module.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.8",
    "@nestjs/core": "^10.2.8",
    "@nestjs/platform-fastify": "^10.2.8",
    "@nestjs/websockets": "^10.2.8",
    "@nestjs/platform-socket.io": "^10.2.8",
    "@nestjs/config": "^3.1.1",
    "@nestjs/swagger": "^7.1.10",
    "@nestjs/typeorm": "^9.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^10.0.2",
    "fastify": "^4.24.3",
    "fastify-cors": "^8.4.2",
    "typeorm": "^0.3.16",
    "sqlite3": "^5.1.6",
    "pg": "^8.11.2",
    "joi": "^17.11.0",
    "zod": "^3.22.4",
    "socket.io": "^4.7.2",
    "binance": "^2.42.0",
    "dotenv": "^16.3.1",
    "libsodium.js": "^0.7.10",
    "winston": "^3.11.0",
    "helmet": "^7.1.0",
    "swagger-ui-fastify": "^1.0.1",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "passport-jwt": "^4.0.1",
    "rxjs": "^7.8.1",
    "axios": "^1.6.1",
    "@grpc/grpc-js": "^1.9.7",
    "@grpc/proto-loader": "^0.7.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.2.8",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.7",
    "@types/node": "^20.9.0",
    "@types/socket.io": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.2.2"
  }
}
